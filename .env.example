FPLGURU_DATABASE_URL=postgresql+asyncpg://fplguru:fplguru@localhost:5432/fplguru
FPLGURU_REDIS_URL=redis://localhost:6379/0
FPLGURU_ENVIRONMENT=local
FPLGURU_FPL_API_BASE=https://fantasy.premierleague.com/api

# Web Push (P1h). Generate a keypair with:  npx web-push generate-vapid-keys
# Leave blank to disable push (the in-app alert feed still works).
FPLGURU_VAPID_PUBLIC_KEY=
FPLGURU_VAPID_PRIVATE_KEY=
FPLGURU_VAPID_SUBJECT=mailto:you@example.com

# xG / xA data (P2a — PitchAPI, https://pitchapi.dev). Blank = xG features disabled.
FPLGURU_PITCHAPI_BASE=https://api.pitchapi.dev/v1
FPLGURU_PITCHAPI_KEY=

# LLM (Google Gemini, REST). Blank = LLM features fall back to templated text.
FPLGURU_GEMINI_KEY=
FPLGURU_GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
FPLGURU_GEMINI_MODEL=gemini-2.0-flash
FPLGURU_LLM_MONTHLY_USD_CAP=5.0
